 "client_script": "frappe.web_form.on('resume_link', (field, value) => {\n    if (!frappe.utils.is_url(value)) {\n        frappe.msgprint(__('Resume link not valid'));\n    }\n});\n\nfrappe.web_form.validate = function() {\n    let errors = [];\n    // Let Frappe's built-in validation run first\n    frappe.web_form.fields.forEach(field => {\n        if (field.reqd && !frappe.web_form.get_value(field.fieldname)) {\n            errors.push(`${field.label}`);\n        }\n    });\n    // Validate Resume Attachment (for fields of type \"Attach\")\n    let resume = frappe.web_form.doc.resume_attachment;\n    if (!resume || resume.trim() === \"\") {\n        errors.push(\"Resume Attachment\");\n    }else {\n        // \u2705 Check if the attached file is a PDF\n        const file_ext = resume.split('.').pop().toLowerCase();\n        if (file_ext !== 'pdf') {\n            errors.push(\"Resume Attachment must be a PDF file.\");\n        }\n    }\n    // If any errors exist, show them all at once\n    if (errors.length > 0) {\n        frappe.msgprint(\"Required Fields:\");\n        frappe.msgprint(errors.join(\"<br>\"), \"Validation Error\");\n        return false; // Prevents submission\n    }\n};\n\n\n",
