 "report_name": "Employee Reimbursements",
 "report_script": "from_date = filters.get('from_date')\r\nto_date = filters.get('to_date')\r\n\r\nif from_date and to_date:\r\n    result = frappe.db.sql(\"\"\"\r\n        SELECT employee, employee_name, reimbursement_type, CAST(creation AS DATE) as creation, SUM(total_amount), custom_employee_user\r\n        FROM `tabReimbursement`\r\n        WHERE CAST(creation AS DATE) >= %s AND CAST(creation AS DATE) <= %s AND reimbursement_type = 'Medical'\r\n        GROUP BY employee, CAST(creation AS DATE)\r\n    \"\"\", (from_date, to_date))\r\nelse:\r\n    result = frappe.db.sql(\"\"\"\r\n        SELECT employee, employee_name, reimbursement_type, CAST(creation AS DATE) as creation, SUM(total_amount)\r\n        FROM `tabReimbursement`\r\n        GROUP BY employee, CAST(creation AS DATE)\r\n    \"\"\")",
