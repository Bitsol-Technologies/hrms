 "query": "SELECT\r\n  applicant_status AS \"Applicant Status\",\r\n  COUNT(name) AS \"Applicant Count\"\r\nFROM\r\n  `tabJob Applicant`\r\nWHERE\r\n  applicant_status IS NOT NULL\r\nGROUP BY\r\n  applicant_status\r\nHAVING COUNT(name) > 0\r\nORDER BY COUNT(name) DESC",
